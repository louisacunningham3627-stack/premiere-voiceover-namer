{
  "manifestVersion": 5,
  "id": "com.hechao.premiere.voiceover-namer",
  "name": "赫朝录音命名器",
  "shortname": "录音命名器",
  "version": "0.3.3",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "localFileSystem": "fullAccess"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "voiceoverNamer",
      "label": {
        "default": "赫朝录音命名器"
      },
      "minimumSize": {
        "width": 300,
        "height": 360
      },
      "maximumSize": {
        "width": 1200,
        "height": 1600
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 620
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 680
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/dark.svg",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium"]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/light.svg",
          "scale": [1, 2],
          "theme": ["lightest", "light"]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/dark.svg",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "all"],
      "species": ["pluginList"]
    },
    {
      "width": 48,
      "height": 48,
      "path": "icons/light.svg",
      "scale": [1, 2],
      "theme": ["lightest", "light"],
      "species": ["pluginList"]
    }
  ]
}
